{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://trend-brain.local/schemas/hermes-analysis.schema.json",
  "title": "Trend Brain Hermes Analysis",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "event_id",
    "evidence_version",
    "stage",
    "title",
    "summary",
    "entities",
    "evidence_ids",
    "viral_score",
    "confidence",
    "manipulation_risk",
    "rwa_relevance",
    "reason_codes",
    "decision",
    "risk_notes",
    "rwa_matches",
    "score_version",
    "prompt_version",
    "model_version",
    "analyzed_at"
  ],
  "properties": {
    "schema_version": { "const": "hermes-analysis-v1.0" },
    "event_id": { "type": "string", "minLength": 1 },
    "evidence_version": { "type": "string", "minLength": 1 },
    "stage": { "enum": ["CATALYST", "EMERGING", "BREAKOUT", "REJECTED", "EXPIRED"] },
    "title": { "type": "string", "minLength": 1, "maxLength": 240 },
    "summary": { "type": "string", "minLength": 1, "maxLength": 2000 },
    "entities": {
      "type": "array",
      "items": { "type": "string", "minLength": 1 },
      "uniqueItems": true
    },
    "evidence_ids": {
      "type": "array",
      "minItems": 1,
      "items": { "type": "string", "minLength": 1 },
      "uniqueItems": true
    },
    "viral_score": { "type": "integer", "minimum": 0, "maximum": 100 },
    "confidence": { "type": "number", "minimum": 0, "maximum": 1 },
    "manipulation_risk": { "type": "integer", "minimum": 0, "maximum": 100 },
    "rwa_relevance": { "type": "integer", "minimum": 0, "maximum": 100 },
    "reason_codes": {
      "type": "array",
      "items": {
        "enum": [
          "AUTHORITATIVE_PRIMARY_SOURCE",
          "INDEPENDENT_CORROBORATION",
          "ABOVE_AUTHOR_BASELINE",
          "EARLY_ACCELERATION",
          "CROSS_PLATFORM_SPREAD",
          "NOVEL_NARRATIVE",
          "SUSTAINED_GROWTH",
          "INSUFFICIENT_EVIDENCE",
          "DUPLICATE_NARRATIVE",
          "STALE_EVENT",
          "POSSIBLE_COORDINATION",
          "POSSIBLE_MISINFORMATION",
          "LOW_RWA_RELEVANCE"
        ]
      },
      "uniqueItems": true
    },
    "decision": { "enum": ["PUBLISH_CANDIDATE", "HOT_WATCH", "MONITOR", "NEED_MORE_EVIDENCE", "REJECT"] },
    "risk_notes": {
      "type": "array",
      "items": { "type": "string", "maxLength": 500 }
    },
    "rwa_matches": {
      "type": "array",
      "maxItems": 4,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["asset_id", "score", "rationale", "catalog_version"],
        "properties": {
          "asset_id": { "type": "string", "minLength": 1 },
          "score": { "type": "integer", "minimum": 0, "maximum": 100 },
          "rationale": { "type": "string", "minLength": 1, "maxLength": 1000 },
          "catalog_version": { "type": "string", "minLength": 1 }
        }
      }
    },
    "no_safe_recommendation": { "type": "boolean", "default": false },
    "next_check_minutes": { "type": ["integer", "null"], "minimum": 1, "maximum": 1440 },
    "expires_at": { "type": ["string", "null"], "format": "date-time" },
    "score_version": { "type": "string", "minLength": 1 },
    "prompt_version": { "type": "string", "minLength": 1 },
    "model_version": { "type": "string", "minLength": 1 },
    "analyzed_at": { "type": "string", "format": "date-time" }
  },
  "allOf": [
    {
      "if": {
        "properties": { "no_safe_recommendation": { "const": true } },
        "required": ["no_safe_recommendation"]
      },
      "then": { "properties": { "rwa_matches": { "maxItems": 0 } } }
    }
  ]
}
