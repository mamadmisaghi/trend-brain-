{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://trend-brain.local/schemas/raw-event.schema.json",
  "title": "Trend Brain Normalized Raw Event",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "provider",
    "native_id",
    "source_type",
    "source_url",
    "published_at",
    "received_at",
    "content_hash"
  ],
  "properties": {
    "schema_version": { "const": "raw-event-v1.0" },
    "provider": { "type": "string", "minLength": 1 },
    "native_id": { "type": "string", "minLength": 1 },
    "source_type": {
      "enum": ["news", "social_post", "social_profile", "video", "comment", "official_release", "market_event"]
    },
    "source_url": { "type": "string", "format": "uri" },
    "canonical_url": { "type": ["string", "null"], "format": "uri" },
    "account_id": { "type": ["string", "null"] },
    "account_handle": { "type": ["string", "null"] },
    "language": { "type": ["string", "null"] },
    "text": { "type": ["string", "null"] },
    "content_hash": { "type": "string", "minLength": 16 },
    "published_at": { "type": "string", "format": "date-time" },
    "received_at": { "type": "string", "format": "date-time" },
    "metrics": {
      "type": "object",
      "additionalProperties": { "type": ["number", "integer", "null"] }
    },
    "provider_ai": {
      "type": ["object", "null"],
      "description": "Untrusted provider-supplied ratings retained as features, not ground truth."
    },
    "raw_payload_ref": { "type": ["string", "null"] }
  }
}
