# Never commit real values. Copy this file to a protected server-side environment file.
BRIGHTDATA_TOKEN=
OPENNEWS_TOKEN=

# Internal Trend Brain API used by Hermes. Keep it on a private network or localhost.
TRND_INTERNAL_API_URL=http://127.0.0.1:8787
TRND_INTERNAL_API_TOKEN=

# Application-owned database. Do not use Hermes' internal state database.
DATABASE_URL=postgresql://trend_brain:change-me@127.0.0.1:5432/trend_brain

# Operational defaults
TRND_TIMEZONE=UTC
TRND_MAX_HERMES_CANDIDATES_PER_RUN=5
TRND_BRIGHTDATA_DAILY_RECORD_BUDGET=50
